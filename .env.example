# Postgres (Railway Postgres in prod)
DATABASE_URL=postgres://made_of:made_of@localhost:5432/made_of

# Cloudflare -> origin lock header. The service rejects requests missing this header
# except in development. Generate with: openssl rand -hex 32
ORIGIN_LOCK_SECRET=

# Node env
NODE_ENV=development

# Better Auth. Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL must match the public URL the browser uses to reach the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (magic-link email). If RESEND_API_KEY is unset, the magic-link URL is
# logged to the server console instead of being emailed, which is handy locally.
RESEND_API_KEY=
RESEND_FROM=Made Of <login@madeof.app>

# Dev-only. Comma-separated emails that get role=admin on sign-in. Ignored
# when NODE_ENV=production. Also powers the "Dev sign in" button on /sign-in,
# which skips the magic-link email round-trip.
DEV_ADMIN_EMAILS=
# Pre-fills the dev sign-in button. Leave unset to type an email each time.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
