# Postgres (Railway Postgres in prod)
DATABASE_URL=postgres://made_of:made_of@localhost:5432/made_of

# Cloudflare -> origin lock header. The service rejects requests missing this header
# except in development. Generate with: openssl rand -hex 32
ORIGIN_LOCK_SECRET=

# Node env
NODE_ENV=development

# Better Auth. Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL must match the public URL the browser uses to reach the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (magic-link email). If RESEND_API_KEY is unset, the magic-link URL is
# logged to the server console instead of being emailed, which is handy locally.
RESEND_API_KEY=
RESEND_FROM=Made Of <login@madeof.app>

# Dev-only. Comma-separated emails that get role=admin on sign-in. Ignored
# when NODE_ENV=production. Also powers the "Dev sign in" button on /sign-in,
# which skips the magic-link email round-trip.
DEV_ADMIN_EMAILS=
# Pre-fills the dev sign-in button. Leave unset to type an email each time.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=

# Stealth mode. When =1, middleware redirects every unauthenticated request
# to /sign-in. Pair with INVITES_REQUIRED=1 to gate new sign-ups to invite
# codes. Unset to open the site publicly.
STEALTH_MODE=
# Soft-launch gate. When =1, new emails must present a valid invite code at
# sign-in. Returning users bypass the check.
INVITES_REQUIRED=

# PostHog. Project API key (phc_...) + region host. Leave unset to disable
# analytics in development. Events are tagged with an `environment` super-
# property so a single project can host dev/preview/prod traffic.
# See docs/POSTHOG.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Combine server-authoritative runs (T-0175). When =1, in-progress Combine
# state lives on the server (combine_runs table) and scores are validated
# via event-log replay. Default off; the client falls back to localStorage.
# COMBINE_SIGNING_SECRET is required when enabled — it signs anonymous
# session cookies so guests can resume runs without an account. Generate
# with: openssl rand -hex 32
COMBINE_SERVER_RUNS=
COMBINE_SIGNING_SECRET=
